# Agent Defer — environment configuration
# Copy to .env and source before running, or export variables directly.

# Root directory for all runtime state (tasks, archives, logs).
# DEFER_RUNTIME_DIR="$HOME/data/runtime"

# Active task store. Defaults to $DEFER_RUNTIME_DIR/deferred.jsonl.
# DEFER_TASKS_FILE="$DEFER_RUNTIME_DIR/deferred.jsonl"

# Monthly archive directory. Defaults to $DEFER_RUNTIME_DIR/archive.
# DEFER_ARCHIVE_DIR="$DEFER_RUNTIME_DIR/archive"

# Directory for prompt artifacts and audit log.
# DEFER_LOG_DIR="$DEFER_RUNTIME_DIR/logs"

# Audit log file. Defaults to $DEFER_LOG_DIR/deferred.log.
# DEFER_LOG_FILE="$DEFER_LOG_DIR/deferred.log"

# Timezone for non-ISO time expressions. Uses system timezone if unset.
# DEFER_TIMEZONE="America/Chicago"

# Optional executor. Must be an executable path. Receives task JSON on stdin.
# If unset, execution writes a prompt artifact and stops.
# DEFER_EXECUTOR="/usr/local/bin/my-executor"

# Fallback context file for reorient_snapshot.py when --reorient is used
# without --context-file or --project.
# DEFER_CONTEXT_FILE="$HOME/data/research/CONTEXT.md"

# Delay in seconds before retrying a failed executor. Default: 60.
# DEFER_RETRY_DELAY_SECONDS="60"
